# StrikeCast — environment variables (copy to .env, never commit .env itself)
#
# None of these are required for the MVP/demo pipeline (all sources run in
# synthetic/demo mode with no external calls). They are placeholders for
# the Future/advanced step of wiring up real data sources.

# MOSDAC/ISRO satellite data API credentials (not yet used — future work)
# SATELLITE_API_KEY=

# Lightning network feed credentials (not yet used — future work)
# LIGHTNING_API_KEY=

# NWP data provider credentials, e.g. NCMRWF/ECMWF (not yet used — future work)
# NWP_API_KEY=
